[
  {
    "name": "spec sample: 10 issues in order, Fix all leaves the unfixable tip",
    "input": "/* Paste your CSS or HTML here */\n.btn { cursor: pointer; }\n.btn:disabled { cursor: pointer; opacity: .5; }\n.carousel { cursor: -webkit-grab; cursor: grab; }\n.brush { cursor: url(\"brush.png\") 4 28; }\n.link { cursor: hand; }\n.canvas { cursor: crosshar; }\nbody { cursor: pointer; }\n.game { cursor: none; }\n\n<div class=\"card\" onclick=\"openCard()\">Open project</div>\n<button disabled class=\"cursor-pointer\">Pay now</button>\n",
    "expect": [
      "L06",
      "L03",
      "L08",
      "L04",
      "L02",
      "L01",
      "L07",
      "L10",
      "L09",
      "L06"
    ],
    "fixed": "/* Paste your CSS or HTML here */\n.btn { cursor: pointer; }\n.btn:disabled { cursor: not-allowed; opacity: .5; }\n.carousel { cursor: grab; }\n.carousel:active { cursor: grabbing; }\n.brush { cursor: url(\"brush.png\") 4 28, auto; }\n.link { cursor: pointer; }\n.canvas { cursor: crosshair; }\nbody { cursor: auto; }\n.game { cursor: none; }\n\n<div role=\"button\" tabindex=\"0\" style=\"cursor:pointer\" class=\"card\" onclick=\"openCard()\">Open project</div>\n<button disabled class=\"cursor-not-allowed\">Pay now</button>\n"
  },
  {
    "name": "L01 typo gets a suggestion and a fix",
    "input": ".a { cursor: pointr; }",
